{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overwater",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".svelte-kit/cloudflare/_worker.js",
  "assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" },
  "routes": [{ "pattern": "overwater.ing", "custom_domain": true }],
  // Corrections from the tap-to-relabel map (schema.sql). Without it /api/labels returns 501
  // and the app keeps corrections in localStorage.
  "d1_databases": [{ "binding": "DB", "database_name": "lawn-labels", "database_id": "ac728bc5-89c3-4317-9a8a-c8066185f68e" }]
}
